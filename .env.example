# Copy to api/.env (backend) or set these in your host's dashboard. Never commit real values.

# ---------- EDAgent API (FastAPI, api/) ----------
ENVIRONMENT=development
# Browser origins allowed to call the API (comma-separated). Set to the deployed site URL in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload and session limits
MAX_UPLOAD_MB=10
MAX_ROWS=200000
MAX_COLUMNS=300
SESSION_TTL_MINUTES=60
MAX_SESSIONS=8
SESSION_MEMORY_BUDGET_MB=240
# Optional: allow Vercel preview deployments, e.g. ^https://crashcross-[a-z0-9-]+.vercel.app$
ALLOWED_ORIGIN_REGEX=
MAX_RESULTS_PER_SESSION=100
UPLOAD_RATE_PER_MIN=10
CHAT_RATE_PER_MIN=12

# Optional AI chat (Anthropic). Leave ANTHROPIC_API_KEY empty to disable chat.
# The key is read only by the backend and is never sent to the browser.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=60
# Server-side refusal fallbacks (beta server-side-fallback-2026-07-01, fallbacks="default").
LLM_FALLBACKS=true
LLM_BASE_URL=https://api.anthropic.com
# Allow visitors to supply their own Anthropic key per request (header X-LLM-Api-Key). Off by default.
ALLOW_BYOK=false

# ---------- Website (Vite build, web/) ----------
# Public URL of the EDAgent API, baked into the static build. Empty = same origin (/api via dev proxy).
VITE_EDAGENT_API_URL=
